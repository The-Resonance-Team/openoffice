{
  "name": "openoffice",
  "version": "0.1.0",
  "description": "An LLM agent CLI that automates office document work (Word, Excel, PowerPoint).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "openoffice": "bin/openoffice.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build --compile src/index.ts --outfile dist/openoffice --define:OOO_VERSION=\"$(node -p 'require(\"./package.json\").version')\"",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "test": "bun test --timeout=30000 --path-ignore-patterns=test/e2e",
    "test:e2e": "bun test --timeout=60000 test/e2e/",
    "test:coverage": "bun test --timeout=30000 --coverage --coverage-reporter=lcov --path-ignore-patterns=test/e2e && bun run scripts/check-coverage.ts",
    "postinstall": "node scripts/install.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@openoffice/core": "workspace:*",
    "@openoffice/server": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "dependency-cruiser": "^18.1.0",
    "oxlint": "^1.76.0",
    "typescript": "^6",
    "yaml": "^2.7.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Resonance-Team/openoffice.git"
  }
}
