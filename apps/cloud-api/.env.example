# Copy to .env — see docker-compose.yml for the local Postgres.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://openoffice:openoffice@127.0.0.1:5435/openoffice_cloud
# Comma-separated browser origins allowed by CORS (apps/cloud-web).
CORS_ORIGINS=http://localhost:3000
# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
# Swagger UI at /docs in non-production; set true to force in production.
