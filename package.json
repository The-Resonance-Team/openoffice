{
  "name": "openoffice-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:boundaries": "cd apps/cli && bun --bun depcruise src test ../../packages --config ../../.dependency-cruiser.cjs",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --ignore-unknown --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Resonance-Team/openoffice.git"
  },
  "overrides": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/testing": "11.1.28",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
