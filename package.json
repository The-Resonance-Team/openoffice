{
  "name": "openoffice-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:boundaries": "turbo run lint:boundaries",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --ignore-unknown --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Resonance-Team/openoffice.git"
  }
}
